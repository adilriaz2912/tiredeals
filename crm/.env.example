# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tiredeals_crm"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Email (SendGrid)
SENDGRID_API_KEY="your-sendgrid-api-key"
EMAIL_FROM="noreply@tiredeals.com"

# SMS (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+15551234567"

# Shipping APIs
FEDEX_API_KEY="your-fedex-api-key"
FEDEX_SECRET_KEY="your-fedex-secret"
UPS_API_KEY="your-ups-api-key"
UPS_SECRET="your-ups-secret"
USPS_USER_ID="your-usps-user-id"

# Google Maps (for installer search)
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
